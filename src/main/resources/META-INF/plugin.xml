<idea-plugin>
    <id>com.jakubjirak.zerotrustsecret</id>
    <name>Zero-Trust Enterprise Secret Guardian</name>
    <vendor email="support@jakubjirak.com" url="https://jakubjirak.com">Jakub Jirak</vendor>

    <description><![CDATA[
      <p><strong>Zero-Trust Enterprise Secret Guardian</strong></p>
      <p>Eliminate security risks associated with leaked sensitive data (API keys, database access, cloud certificates) during local application development.</p>
      <ul>
          <li>✓ Authenticate to Infisical and Doppler cloud vaults.</li>
          <li>✓ Environment Picker to instantly switch between Dev, Staging, Prod.</li>
          <li>✓ Dynamic Run Configuration Interception to inject secrets into Java-based run configurations without writing them to disk.</li>
          <li>✓ Pre-Commit Scanner Guardrail that warns before committing known vault secrets.</li>
          <li>✓ Log Masking to censor injected secrets in Run/Debug console output.</li>
      </ul>
    ]]></description>


    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <toolWindow id="Zero-Trust Vault" anchor="right" icon="AllIcons.Nodes.KeymapTools"
                    factoryClass="com.jakubjirak.zerotrust.ui.ZeroTrustToolWindowFactory"/>

        <projectService serviceImplementation="com.jakubjirak.zerotrust.settings.VaultSettings"/>
        <projectService serviceImplementation="com.jakubjirak.zerotrust.execution.ZeroTrustSecretCache"/>

        <runConfigurationExtension implementation="com.jakubjirak.zerotrust.execution.ZeroTrustRunConfigurationExtension"/>
        
        <consoleInputFilterProvider implementation="com.jakubjirak.zerotrust.execution.ZeroTrustInputFilterProvider"/>
        
        <checkinHandlerFactory implementation="com.jakubjirak.zerotrust.vcs.ZeroTrustCheckinHandlerFactory"/>
    
        <projectConfigurable
            parentId="tools"
            instance="com.jakubjirak.zerotrust.settings.VaultSettingsConfigurable"
            id="zerotrust.secret.guardian.settings"
            displayName="Zero-Trust Secret Guardian"/>

        <notificationGroup id="Zero-Trust Secret Guardian Feedback" displayType="BALLOON"/>
        <projectActivity implementation="com.jakubjirak.zerotrust.feedback.FeedbackNotifier"/>
    </extensions>

    <projectListeners>
        <listener class="com.jakubjirak.zerotrust.execution.ZeroTrustExecutionListener"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>
</idea-plugin>
